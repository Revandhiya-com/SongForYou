{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2",
      "includeFiles": "Website-SFY/**"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/api/admin.php" },
    { "source": "/admin/(.*)", "destination": "/api/admin.php" },
    { "source": "/backend/:endpoint*", "destination": "/api/backend.php?endpoint=:endpoint*" },
    { "source": "/debug-env", "destination": "/api/debug_env.php" },
    { "source": "/debug-conn", "destination": "/api/debug_conn.php" },
    { "source": "/(.*)", "destination": "/api/index.php" }
  ]
}
