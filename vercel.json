{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2",
      "includeFiles": "Website-SFY/**"
    }
  },
  "routes": [
    {
      "src": "^/admin(/.*)?$",
      "dest": "/api/admin.php"
    },
    {
      "src": "^/backend/(.*)",
      "dest": "/api/backend.php?endpoint=$1"
    },
    {
      "src": "^/(.*\\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|webp|mp3|mp4|json))$",
      "dest": "/Website-SFY/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.php"
    }
  ]
}
