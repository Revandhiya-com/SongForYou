{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/admin(/.*)?$",
      "dest": "/api/admin.php"
    },
    {
      "src": "/backend/(.*)",
      "dest": "/api/backend.php?endpoint=$1"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|webp|mp3))",
      "dest": "/Website-SFY/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
